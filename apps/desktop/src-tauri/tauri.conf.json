{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RainForge NEXUS",
  "version": "0.1.0",
  "identifier": "ai.rainforge.nexus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "RainForge NEXUS", "width": 1440, "height": 960, "minWidth": 700, "minHeight": 600}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/rainforge-worker"],
    "resources": {"../../../runtime/catalog.json": "runtime/catalog.json", "../../../runtime/bin/": "runtime/bin/"},
    "windows": {"nsis": {"installMode": "currentUser"}}
  }
}
